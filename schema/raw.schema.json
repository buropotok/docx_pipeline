{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard RAW JSON Schema v2.10 (with run IDs and fingerprint support)",
  "type": "object",
  "required": ["meta", "document_info", "numbering_definitions", "styles", "character_styles", "content"],
  "additionalProperties": false,

  "$defs": {
    "alignmentEnum": {
      "type": "string",
      "enum": ["LEFT", "CENTER", "RIGHT", "JUSTIFY"]
    },

    "lineRuleEnum": {
      "type": "string",
      "enum": ["AUTO", "AT_LEAST", "EXACT"]
    },

    "textAlignmentEnum": {
      "type": "string",
      "enum": ["AUTO", "BASELINE", "TOP", "CENTER", "BOTTOM"]
    },

    "breakTypeEnum": {
      "type": "string",
      "enum": ["textWrapping", "page", "column"]
    },

    "numberingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numId", "ilvl"],
      "properties": {
        "numId": { "type": "string" },
        "ilvl": { "type": "integer", "minimum": 0 }
      }
    },

    "tabStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posTwip", "val"],
      "properties": {
        "posTwip": { "type": "integer", "minimum": 0 },
        "val": {
          "type": "string",
          "enum": ["left", "center", "right", "decimal", "bar", "clear"]
        },
        "leader": {
          "type": "string",
          "enum": ["none", "dot", "hyphen", "underscore", "heavy", "middleDot"]
        }
      }
    },

    "rFonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ascii": { "type": "string" },
        "hAnsi": { "type": "string" },
        "eastAsia": { "type": "string" },
        "cs": { "type": "string" },
        "asciiTheme": { "type": "string" },
        "hAnsiTheme": { "type": "string" },
        "eastAsiaTheme": { "type": "string" },
        "csTheme": { "type": "string" }
      }
    },

    "pFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alignment": { "$ref": "#/$defs/alignmentEnum" },

        "indentStartTwip": { "type": "integer" },
        "indentEndTwip": { "type": "integer" },
        "indentFirstLineTwip": { "type": "integer" },
        "indentHangingTwip": { "type": "integer" },

        "spaceBeforeTwip": { "type": "integer" },
        "spaceAfterTwip": { "type": "integer" },
        "spaceBeforeLines": { "type": "integer" },
        "spaceAfterLines": { "type": "integer" },

        "beforeAutospacing": { "type": "boolean" },
        "afterAutospacing": { "type": "boolean" },

        "lineTwip": { "type": "integer" },
        "lineRule": { "$ref": "#/$defs/lineRuleEnum" },

        "linePitchTwip": { "type": "integer" },

        "textAlignment": { "$ref": "#/$defs/textAlignmentEnum" },

        "contextualSpacing": { "type": "boolean" },

        "keepNext": { "type": "boolean" },
        "keepLines": { "type": "boolean" },
        "pageBreakBefore": { "type": "boolean" },
        "widowControl": { "type": "boolean" },

        "snapToGrid": { "type": "boolean" },

        "tabs": {
          "type": "array",
          "items": { "$ref": "#/$defs/tabStop" }
        },

        "numbering": { "$ref": "#/$defs/numberingRef" }
      }
    },

    "rFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rFonts": { "$ref": "#/$defs/rFonts" },

        "font_size_half_points": { "type": "integer" },

        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "string" },

        "color": { "type": "string" },

        "vertical_align": {
          "type": "string",
          "enum": ["baseline", "superscript", "subscript"]
        },

        "all_caps": { "type": "boolean" },

        "charSpacingTwip": { "type": "integer" },

        "positionHalfPoints": { "type": "integer" },

        "lang": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "val": { "type": "string" },
            "eastAsia": { "type": "string" },
            "bidi": { "type": "string" }
          }
        }
      }
    },

    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Уникальный идентификатор run в формате run_N, где N - целое число (1-based)"
        },

        "type": {
          "type": "string",
          "enum": [
            "text",
            "tab",
            "break",
            "sym",
            "cr",
            "softHyphen",
            "noBreakHyphen"
          ]
        },

        "text": { "type": "string" },

        "char_style_id": { "type": "string" },

        "break_type": { "$ref": "#/$defs/breakTypeEnum" },

        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "leading": { "type": "boolean" },
            "preserve": { "type": "boolean" }
          }
        }
      },

      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "type": { "const": "sym" } } },
          "then": { "required": ["text"] }
        }
      ]
    }
  },

  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "rules_version"],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": ["2.10"]
        },
        "rules_version": { "type": "string" },
        "default_style_id": { "type": "string" },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "run_id_counter_start": {
          "type": "integer",
          "description": "Начальное значение счётчика run_id (обычно 1)"
        }
      }
    },

    "document_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_setup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pageWidthTwip": { "type": "integer" },
            "pageHeightTwip": { "type": "integer" },
            "orient": { "type": "string", "enum": ["portrait", "landscape"] },
            "marginLeftTwip": { "type": "integer" },
            "marginRightTwip": { "type": "integer" },
            "marginTopTwip": { "type": "integer" },
            "marginBottomTwip": { "type": "integer" },
            "headerTwip": { "type": "integer" },
            "footerTwip": { "type": "integer" },
            "gutterTwip": { "type": "integer" },
            "cols": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "num": { "type": "integer", "minimum": 1 },
                "spaceTwip": { "type": "integer" },
                "equalWidth": { "type": "boolean" }
              }
            }
          }
        },

        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultTabStopTwip": { "type": "integer" }
          }
        }
      }
    },

    "numbering_definitions": {
      "type": "object",
      "description": "Справочник нумерации: ключ = numId (string).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["levels"],
        "properties": {
          "abstractNumId": { "type": "string" },
          "multiLevelType": { "type": "string" },
          "levels": {
            "type": "object",
            "description": "Ключ = ilvl (string).",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "template"],
              "properties": {
                "format": { "type": "string" },
                "template": { "type": "string" },
                "start": { "type": "integer" },
                "tabPosTwip": { "type": "integer" },
                "lvlJc": { "type": "string" },
                "suff": { "type": "string" },
                "pStyle": { "type": "string" },
                "level_pPr": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "indentStartTwip": { "type": "integer" },
                    "indentEndTwip": { "type": "integer" },
                    "indentFirstLineTwip": { "type": "integer" },
                    "indentHangingTwip": { "type": "integer" },
                    "tabs": {
                      "type": "array",
                      "items": { "$ref": "#/$defs/tabStop" }
                    }
                  }
                },
                "level_rPr": { "$ref": "#/$defs/rFormat" }
              }
            }
          },
          "lvl_overrides": {
            "type": "object",
            "description": "Опциональные overrides уровней. Ключ = ilvl (string).",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": { "type": "integer" }
              }
            }
          }
        }
      }
    },

    "styles": {
      "type": "object",
      "description": "Библиотека параграфных стилей (p_format + r_format). Ключ = style_id.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["p_format", "r_format"],
        "properties": {
          "p_format": { "$ref": "#/$defs/pFormat" },
          "r_format": { "$ref": "#/$defs/rFormat" },
          "title": { "type": "string" },
          "word_style_id": { "type": "string" },
          "source_word_style_id": { "type": "string" }
        }
      }
    },

    "character_styles": {
      "type": "object",
      "description": "Библиотека символьных стилей (только r_format). Ключ = style_id.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["r_format"],
        "properties": {
          "r_format": { "$ref": "#/$defs/rFormat" },
          "title": { "type": "string" },
          "word_style_id": { "type": "string" }
        }
      }
    },

    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["style_id", "runs"],
        "properties": {
          "style_id": { "type": "string" },
          "source_word_style_id": { "type": "string" },
          "p_format": { "$ref": "#/$defs/pFormat" },
          "runs": {
            "type": "array",
            "items": { "$ref": "#/$defs/run" }
          }
        }
      }
    }
  }
}