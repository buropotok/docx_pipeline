{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://translatefactory/schema/raw/2.16",
  "title": "Standard RAW JSON Schema v2.16 (aligned with parser v43 / reconstructor v2.15)",
  "version": "2.16",
  "type": "object",
  "required": [
    "meta",
    "document_info",
    "numbering_definitions",
    "doc_defaults",
    "styles",
    "content"
  ],
  "additionalProperties": false,
  "$defs": {
    "alignmentEnum": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right",
        "justify",
        "distribute"
      ]
    },
    "breakTypeEnum": {
      "type": "string",
      "enum": [
        "page",
        "column",
        "textWrapping",
        "line"
      ]
    },
    "lineRuleEnum": {
      "type": "string",
      "enum": [
        "auto",
        "exact",
        "atLeast"
      ]
    },
    "positionEnum": {
      "type": "string",
      "enum": ["before", "after"]
    },
    "numberingRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numId": {
          "description": "Идентификатор списка (w:numId/@w:val).",
          "type": "string"
        },
        "ilvl": {
          "description": "Уровень (w:ilvl/@w:val).",
          "type": "string"
        }
      },
      "required": [
        "numId",
        "ilvl"
      ]
    },
    "pFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "$ref": "#/$defs/alignmentEnum"
        },
        "text_alignment": {
          "$ref": "#/$defs/textAlignmentEnum"
        },
        "contextual_spacing": {
          "type": "boolean",
          "description": "Контекстуальное пространство перед/после абзаца"
        },
        "line_spacing_twip": {
          "description": "Интервал между строками (w:spacing/@w:line) в твипах.",
          "type": "integer"
        },
        "line_rule": {
          "$ref": "#/$defs/lineRuleEnum"
        },
        "space_before_twip": {
          "description": "Интервал перед абзацем (w:spacing/@w:before) в твипах.",
          "type": "integer"
        },
        "space_after_twip": {
          "description": "Интервал после абзаца (w:spacing/@w:after) в твипах.",
          "type": "integer"
        },
        "indent_start_twip": {
          "description": "Отступ слева (w:ind/@w:start) в твипах.",
          "type": "integer"
        },
        "indent_end_twip": {
          "description": "Отступ справа (w:ind/@w:end) в твипах.",
          "type": "integer"
        },
        "indent_first_line_twip": {
          "description": "Отступ первой строки (w:ind/@w:firstLine) в твипах.",
          "type": "integer"
        },
        "indent_hanging_twip": {
          "description": "Висячий отступ (w:ind/@w:hanging) в твипах.",
          "type": "integer"
        },
        "keep_next": {
          "description": "Keep with next (w:keepNext).",
          "type": "boolean"
        },
        "keep_lines": {
          "description": "Keep lines together (w:keepLines).",
          "type": "boolean"
        },
        "page_break_before": {
          "description": "Page break before (w:pageBreakBefore).",
          "type": "boolean"
        },
        "widow_control": {
          "description": "Widow control (w:widowControl).",
          "type": "boolean"
        },
        "tabs": {
          "description": "Список табуляций (w:tabs).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/tabStop"
          }
        },
        "list_info": {
          "description": "Привязка к нумерации (w:numPr).",
          "$ref": "#/$defs/numberingRef"
        }
      }
    },
    "border": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "val": {
          "type": "string",
          "description": "Стиль линии: single, double, dotted, dashed, etc."
        },
        "sz": {
          "type": "integer",
          "description": "Толщина в 1/8 pt"
        },
        "color": {
          "type": "string",
          "description": "Цвет в формате RRGGBB или 'auto'"
        },
        "space": {
          "type": "integer",
          "description": "Отступ от текста в твипах (опционально)"
        }
      },
      "required": ["val", "sz", "color"]
    },
    "tblBorders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "$ref": "#/$defs/border" },
        "left": { "$ref": "#/$defs/border" },
        "bottom": { "$ref": "#/$defs/border" },
        "right": { "$ref": "#/$defs/border" },
        "insideH": { "$ref": "#/$defs/border" },
        "insideV": { "$ref": "#/$defs/border" }
      }
    },
    "sizeType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "w": {
          "type": "integer",
          "description": "Значение ширины/высоты"
        },
        "type": {
          "type": "string",
          "enum": ["dxa", "pct", "auto"],
          "description": "Единица измерения: dxa (twips), pct (проценты), auto"
        }
      },
      "required": ["w", "type"]
    },
    "tblCellMar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "$ref": "#/$defs/sizeType" },
        "left": { "$ref": "#/$defs/sizeType" },
        "bottom": { "$ref": "#/$defs/sizeType" },
        "right": { "$ref": "#/$defs/sizeType" }
      }
    },
    "shd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "val": {
          "type": "string",
          "description": "Стиль заливки: clear, solid, pct10, etc."
        },
        "color": {
          "type": "string",
          "description": "Цвет штриховки (например, 'auto')"
        },
        "fill": {
          "type": "string",
          "description": "Цвет фона в формате RRGGBB"
        },
        "themeColor": {
          "type": "string",
          "description": "Цвет темы (опционально)"
        },
        "themeTint": {
          "type": "string",
          "description": "Оттенок темы (опционально)"
        },
        "themeShade": {
          "type": "string",
          "description": "Тень темы (опционально)"
        }
      },
      "required": ["val", "fill"]
    },
    "tblLook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstRow": { "type": "boolean", "description": "Применить форматирование первой строки" },
        "lastRow": { "type": "boolean", "description": "Применить форматирование последней строки" },
        "firstColumn": { "type": "boolean", "description": "Применить форматирование первого столбца" },
        "lastColumn": { "type": "boolean", "description": "Применить форматирование последнего столбца" },
        "bandRow": { "type": "boolean", "description": "Применить чередование строк" },
        "bandCol": { "type": "boolean", "description": "Применить чередование столбцов" },
        "noHBand": { "type": "boolean", "description": "Отключить чередование строк" },
        "noVBand": { "type": "boolean", "description": "Отключить чередование столбцов" }
      }
    },
    "tblOverlapEnum": {
      "type": "string",
      "enum": ["overlap", "never"]
    },
    "jcEnum": {
      "type": "string",
      "enum": ["left", "center", "right", "both", "distribute"]
    },
    "hRuleEnum": {
      "type": "string",
      "enum": ["auto", "exact", "atLeast"]
    },
    "vMergeEnum": {
      "type": "string",
      "enum": ["continue", "restart"]
    },
    "textDirectionEnum": {
      "type": "string",
      "enum": ["lr", "tb", "bt", "lrV", "tbV", "btV"]
    },
    "tblPr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tblStyle": { "type": "string", "description": "Идентификатор стиля таблицы (w:tblStyle/@w:val)" },
        "tblpPr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "leftFromText": { "type": "integer" },
            "rightFromText": { "type": "integer" },
            "topFromText": { "type": "integer" },
            "bottomFromText": { "type": "integer" },
            "vertAnchor": { "type": "string", "enum": ["page", "margin", "text"] },
            "horzAnchor": { "type": "string", "enum": ["page", "margin", "text"] },
            "tblpX": { "type": "integer" },
            "tblpY": { "type": "integer" },
            "tblpXSpec": { "type": "string", "enum": ["left", "center", "right", "inside", "outside"] },
            "tblpYSpec": { "type": "string", "enum": ["top", "center", "bottom"] }
          }
        },
        "tblOverlap": { "$ref": "#/$defs/tblOverlapEnum" },
        "tblW": { "$ref": "#/$defs/sizeType" },
        "jc": { "$ref": "#/$defs/jcEnum" },
        "tblInd": { "$ref": "#/$defs/sizeType" },
        "tblBorders": { "$ref": "#/$defs/tblBorders" },
        "tblCellMar": { "$ref": "#/$defs/tblCellMar" },
        "tblCellSpacing": { "$ref": "#/$defs/sizeType" },
        "tblLayout": { "type": "string", "enum": ["autofit", "fixed"] },
        "tblLook": { "$ref": "#/$defs/tblLook" },
        "tblCaption": { "type": "string" },
        "tblDescription": { "type": "string" }
      }
    },
    "trPr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trHeight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "val": { "type": "integer" },
            "hRule": { "$ref": "#/$defs/hRuleEnum" }
          },
          "required": ["val", "hRule"]
        },
        "tblHeader": { "type": "boolean" },
        "cantSplit": { "type": "boolean" },
        "jc": { "$ref": "#/$defs/jcEnum" }
      }
    },
    "tcPr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tcW": { "$ref": "#/$defs/sizeType" },
        "gridSpan": { "type": "integer", "minimum": 1 },
        "vMerge": { "$ref": "#/$defs/vMergeEnum" },
        "tcBorders": { "$ref": "#/$defs/tblBorders" },
        "shd": { "$ref": "#/$defs/shd" },
        "tcMar": { "$ref": "#/$defs/tblCellMar" },
        "vAlign": {
          "type": "string",
          "enum": ["top", "center", "bottom"]
        },
        "textDirection": { "$ref": "#/$defs/textDirectionEnum" },
        "tcFitText": { "type": "boolean" },
        "noWrap": { "type": "boolean" }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cells"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Уникальный идентификатор строки (сквозной, сохраняется во всём пайплайне)"
        },
        "derive_from": { "type": "string" },
        "trPr": { "$ref": "#/$defs/trPr", "description": "Локальные свойства строки (переопределения)" },
        "cells": {
          "type": "array",
          "description": "Ячейки строки (порядок важен)",
          "items": { "$ref": "#/$defs/tableCell" }
        }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Уникальный идентификатор ячейки (опционально)"
        },
        "tcPr": { "$ref": "#/$defs/tcPr", "description": "Локальные свойства ячейки (переопределения)" },
        "content": {
          "type": "array",
          "description": "Содержимое ячейки (массив абзацев)",
          "items": { "$ref": "#/$defs/paragraph" }
        }
      }
    },
    "rFonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ascii": {
          "type": "string"
        },
        "hAnsi": {
          "type": "string"
        },
        "eastAsia": {
          "type": "string"
        },
        "cs": {
          "type": "string"
        },
        "asciiTheme": {
          "type": "string"
        },
        "hAnsiTheme": {
          "type": "string"
        },
        "eastAsiaTheme": {
          "type": "string"
        },
        "csTheme": {
          "type": "string"
        }
      }
    },
    "rFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "description": "Подчеркивание (упрощённо). Рекомендуется расширить до объекта при добавлении themeColor и др.",
          "type": "string"
        },
        "strike": {
          "type": "boolean"
        },
        "double_strike": {
          "type": "boolean"
        },
        "caps": {
          "type": "boolean"
        },
        "small_caps": {
          "type": "boolean"
        },
        "color": {
          "description": "Цвет текста (упрощённо). Может быть расширен до объекта (val/themeColor/tint/shade).",
          "type": "string"
        },
        "highlight": {
          "type": "string"
        },
        "shading": {
          "type": "string"
        },
        "vert_align": {
          "description": "vertical alignment (w:vertAlign): superscript/subscript.",
          "type": "string"
        },
        "font_size_half_points": {
          "description": "Размер шрифта в half-points (w:sz/@w:val). 24 => 12pt.",
          "type": "integer"
        },
        "rFonts": {
          "$ref": "#/$defs/rFonts"
        },
        "lang": {
          "type": "string"
        },
        "spacing_twip": {
          "description": "Межбуквенный интервал (w:spacing) в твипах.",
          "type": "integer"
        },
        "kern_half_points": {
          "description": "Кернинг (w:kern) в half-points.",
          "type": "integer"
        },
        "position_half_points": {
          "description": "Смещение (w:position) в half-points.",
          "type": "integer"
        },
        "szCs_half_points": {
          "description": "Размер для complex script (w:szCs) в half-points.",
          "type": "integer"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "description": "Тип элемента. picture — изображение, встраиваемое в документ",
          "type": "string",
          "enum": [
            "text",
            "tab",
            "break",
            "sym",
            "cr",
            "softHyphen",
            "noBreakHyphen",
            "picture",
            "shape"
          ]
        },
        "id": {
          "description": "Уникальный идентификатор run в формате run_N, где N - целое число (1-based)",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "break_type": {
          "$ref": "#/$defs/breakTypeEnum"
        },
        "parent_id": {
          "type": "string",
          "description": "Идентификатор родительского абзаца для данного run (например, p_1)"
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preserve": {
              "type": "boolean"
            },
            "leading": {
              "type": "boolean"
            }
          }
        },
        "r_style_id": {
          "type": "string",
          "description": "Character styleId (w:rStyle/@w:val) — ключ в styles."
        },
        "r_format": {
          "$ref": "#/$defs/rFormat",
          "description": "Inline override для run properties (w:rPr), поверх стиля. Использовать вместо синтетических character_styles."
        },
        "char_style_id": {
          "type": "string",
          "description": "[DEPRECATED] Синтетический символьный стиль. Используйте r_style_id."
        },
        "file": {
          "type": "string",
          "description": "Относительный путь Target к изображению относительно word/document.xml (обычно 'media/<name.ext>')."
        },
        "relation_id": {
          "type": "string",
          "description": "Идентификатор отношения (rId) для ссылки на изображение из document.xml.rels"
        },
        "extent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cx": {
              "type": "integer",
              "description": "Ширина в EMU (для wp:extent/a:ext)."
            },
            "cy": {
              "type": "integer",
              "description": "Высота в EMU (для wp:extent/a:ext)."
            }
          }
        },
        "description": {
          "type": "string",
          "description": "Альтернативный текст изображения (alt)"
        },
        "shape": {
          "$ref": "#/$defs/shapeProperties",
          "description": "Свойства фигуры (только если type='shape')"
        }
      },
      "allOf": [

        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sym"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "picture"
              }
            }
          },
          "then": {
            "required": [
              "file"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shape"
              }
            }
          },
          "then": {
            "required": [
              "shape"
            ]
          }
        }
      ]
    },
    "shapeExtent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cx": {
          "type": "integer",
          "description": "Ширина фигуры в EMU"
        },
        "cy": {
          "type": "integer",
          "description": "Высота фигуры в EMU"
        }
      },
      "required": ["cx", "cy"]
    },
    "shapeTransform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rotation": {
          "type": "integer",
          "description": "Угол поворота в 60-тысячных долях градуса (90° = 5 400 000)"
        },
        "flipH": {
          "type": "boolean",
          "description": "Отразить по горизонтали"
        },
        "flipV": {
          "type": "boolean",
          "description": "Отразить по вертикали"
        }
      }
    },
    "shapeFill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "description": "Цвет заливки в формате RGB (например, 'FF0000')"
        },
        "alpha": {
          "type": "integer",
          "description": "Прозрачность (0–100000)"
        }
      }
    },
    "shapeOutline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "description": "Толщина линии в EMU (1 pt = 12 700 EMU)"
        },
        "color": {
          "type": "string",
          "description": "Цвет линии"
        },
        "alpha": {
          "type": "integer",
          "description": "Прозрачность линии"
        },
        "dashStyle": {
          "type": "string",
          "enum": ["solid", "dash", "dot", "dashDot", "dashDotDot"],
          "description": "Стиль пунктира"
        }
      }
    },
    "shapeText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/run" },
          "description": "Массив run'ов внутри фигуры (аналогично содержимому абзаца)"
        },
        "margins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": { "type": "integer" },
            "right": { "type": "integer" },
            "top": { "type": "integer" },
            "bottom": { "type": "integer" }
          }
        },
        "verticalAnchor": {
          "type": "string",
          "enum": ["top", "middle", "bottom"],
          "description": "Вертикальное выравнивание текста внутри фигуры"
        }
      }
    },
    "shapePositioning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativeFrom": {
          "type": "string",
          "enum": ["page", "column", "character", "margin"],
          "description": "Относительно чего позиционируется фигура"
        },
        "horizontalPos": {
          "type": "integer",
          "description": "Горизонтальное смещение в EMU"
        },
        "verticalPos": {
          "type": "integer",
          "description": "Вертикальное смещение в EMU"
        },
        "allowOverlap": {
          "type": "boolean",
          "description": "Разрешить перекрытие"
        }
      }
    },
    "shapeProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shapeType": {
          "type": "string",
          "description": "Тип фигуры (предопределённое имя, например 'rect', 'ellipse', 'line', 'roundRect')"
        },
        "extent": {
          "$ref": "#/$defs/shapeExtent",
          "description": "Размеры фигуры в EMU"
        },
        "transform": {
          "$ref": "#/$defs/shapeTransform",
          "description": "Преобразования (поворот, отражение)"
        },
        "fill": {
          "$ref": "#/$defs/shapeFill",
          "description": "Заливка фигуры"
        },
        "outline": {
          "$ref": "#/$defs/shapeOutline",
          "description": "Обводка фигуры"
        },
        "text": {
          "$ref": "#/$defs/shapeText",
          "description": "Текстовое содержимое фигуры"
        },
        "positioning": {
          "$ref": "#/$defs/shapePositioning",
          "description": "Позиционирование (для плавающих фигур)"
        }
      },
      "required": ["shapeType", "extent"]
    },
    "tabStop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "posTwip": {
          "type": "integer"
        },
        "val": {
          "type": "string"
        },
        "leader": {
          "type": "string"
        }
      }
    },
    "textAlignmentEnum": {
      "type": "string",
      "enum": [
        "auto",
        "baseline",
        "top",
        "center",
        "bottom"
      ]
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "p_style_id",
        "runs",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "paragraph"
        },
        "id": {
          "type": "string",
          "description": "Уникальный идентификатор абзаца"
        },
         "deleted": {
          "type": "boolean",
          "description": "Patch-op: если true, управляемый блок удаляется (удаляется SDT-wrapper)."
        },
        "anchor": {
          "type": "string",
          "description": "Patch-op: id якоря (управляемый блок), относительно которого позиционируется этот элемент."
        },
        "position": {
          "$ref": "#/$defs/positionEnum",
          "description": "Patch-op: before|after относительно anchor. Порядок вставок определяется порядком элементов в content."
        },
        "derive_from": {
          "type": "string",
          "description": "Patch-op: если элемента с таким id нет в XML, создать его как clone XML элемента derive_from, затем применить overrides."
        },
        "p_style_id": {
          "type": "string",
          "description": "Paragraph styleId (w:pStyle/@w:val) — ключ в styles."
        },
        "p_format": {
          "$ref": "#/$defs/pFormat",
          "description": "Inline override для paragraph properties (w:pPr), поверх стиля."
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "source_word_style_id": {
          "type": "string",
          "description": "[DEPRECATED] Старое поле для отладки/трассировки."
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "rows"],
      "properties": {
        "type": {
          "type": "string",
          "const": "table"
        },
        "id": {
          "type": "string",
          "description": "Уникальный идентификатор таблицы (сквозной, сохраняется во всём пайплайне)"
        },
         "deleted": { "type": "boolean" },
        "anchor": { "type": "string" },
        "position": { "$ref": "#/$defs/positionEnum" },
        "derive_from": { "type": "string" },
        "tblPr": {
          "$ref": "#/$defs/tblPr",
          "description": "Локальные свойства таблицы (переопределения)"
        },
        "tbl_grid": {
          "type": "array",
          "description": "Ширина колонок в твипах (w:tblGrid/w:gridCol/@w:w)",
          "items": { "type": "integer" }
        },
        "tbl_style_id": {
          "type": "string",
          "description": "Идентификатор стиля таблицы (ключ в styles) — опционально, если не меняется"
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableRow" }
        }
      }
    },
    "contentItem": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/table" }
      ]
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_file": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "default_style_id": {
          "type": "string"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        }
      },
      "required": ["schema_version"]
    },
    "document_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_setup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pageWidthTwip": {
              "type": "integer"
            },
            "pageHeightTwip": {
              "type": "integer"
            },
            "orient": {
              "type": "string",
              "enum": [
                "portrait",
                "landscape"
              ]
            },
            "marginTopTwip": {
              "type": "integer"
            },
            "marginBottomTwip": {
              "type": "integer"
            },
            "marginLeftTwip": {
              "type": "integer"
            },
            "marginRightTwip": {
              "type": "integer"
            },
            "headerTwip": {
              "type": "integer"
            },
            "footerTwip": {
              "type": "integer"
            },
            "gutterTwip": {
              "type": "integer"
            },
            "cols": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "num": {
                  "type": "integer",
                  "minimum": 1
                },
                "spaceTwip": {
                  "type": "integer"
                },
                "equalWidth": {
                  "type": "boolean"
                }
              }
            },
            "linePitchTwip": {
              "type": "integer"
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultTabStopTwip": {
              "type": "integer"
            }
          }
        }
      }
    },
    "numbering_definitions": {
      "type": "object",
      "description": "Справочник нумерации: ключ = numId (string).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "levels"
        ],
        "properties": {
          "abstractNumId": {
            "type": "string"
          },
          "multiLevelType": {
            "type": "string"
          },
          "levels": {
            "type": "object",
            "description": "Ключ = ilvl (string).",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format",
                "template"
              ],
              "properties": {
                "format": {
                  "type": "string"
                },
                "template": {
                  "type": "string"
                },
                "start": {
                  "type": "integer"
                },
                "lvlJc": {
                  "type": "string"
                },
                "suff": {
                  "type": "string"
                },
                "tabPosTwip": {
                  "type": "integer"
                },
                "pStyle": {
                  "type": "string"
                },
                "level_rPr": {
                  "$ref": "#/$defs/rFormat"
                },
                "level_pPr": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "indentStartTwip": {
                      "type": "integer"
                    },
                    "indentEndTwip": {
                      "type": "integer"
                    },
                    "indentFirstLineTwip": {
                      "type": "integer"
                    },
                    "indentHangingTwip": {
                      "type": "integer"
                    },
                    "tabs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/tabStop"
                      }
                    }
                  }
                }
              }
            }
          },
          "lvl_overrides": {
            "type": "object",
            "description": "Опциональные overrides уровней. Ключ = ilvl (string).",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "doc_defaults": {
      "type": "object",
      "description": "Нормы форматирования документа из styles.xml/w:docDefaults (основа для всех стилей).",
      "additionalProperties": false,
      "required": [
        "p_format",
        "r_format"
      ],
      "properties": {
        "p_format": {
          "$ref": "#/$defs/pFormat"
        },
        "r_format": {
          "$ref": "#/$defs/rFormat"
        }
      }
    },
    "latent_styles": {
      "type": "object",
      "description": "Нормализованные настройки w:latentStyles (если присутствуют в styles.xml).",
      "additionalProperties": false,
      "properties": {
        "defaultLockedState": {
          "type": "boolean"
        },
        "defaultSemiHiddenState": {
          "type": "boolean"
        },
        "defaultUnhideWhenUsedState": {
          "type": "boolean"
        },
        "defaultQFormatState": {
          "type": "boolean"
        },
        "defaultUiPriority": {
          "type": "integer"
        },
        "exceptions": {
          "type": "object",
          "description": "Исключения по конкретным styleId.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "locked": {
                "type": "boolean"
              },
              "semiHidden": {
                "type": "boolean"
              },
              "unhideWhenUsed": {
                "type": "boolean"
              },
              "qFormat": {
                "type": "boolean"
              },
              "uiPriority": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "description": "Библиотека стилей, импортированных из word/styles.xml. Ключ = word styleId (например 'Normal', 'Heading1', 'a').",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "paragraph",
              "character",
              "table",
              "numbering"
            ]
          },
          "name": {
            "type": "string",
            "description": "w:name/@w:val"
          },
          "based_on": {
            "type": "string",
            "description": "w:basedOn/@w:val"
          },
          "next": {
            "type": "string",
            "description": "w:next/@w:val"
          },
          "link": {
            "type": "string",
            "description": "w:link/@w:val (linked style para<->char)"
          },
          "is_default": {
            "type": "boolean",
            "description": "w:style/@w:default"
          },
          "custom": {
            "type": "boolean",
            "description": "w:style/@w:customStyle"
          },
          "ui_priority": {
            "type": "integer",
            "description": "w:uiPriority/@w:val"
          },
          "q_format": {
            "type": "boolean",
            "description": "presence of w:qFormat"
          },
          "semi_hidden": {
            "type": "boolean",
            "description": "presence of w:semiHidden"
          },
          "unhide_when_used": {
            "type": "boolean",
            "description": "presence of w:unhideWhenUsed"
          },
          "locked": {
            "type": "boolean",
            "description": "presence of w:locked"
          },
          "p_format": {
            "$ref": "#/$defs/pFormat",
            "description": "Paragraph properties (w:pPr) for paragraph styles."
          },
          "r_format": {
            "$ref": "#/$defs/rFormat",
            "description": "Run properties (w:rPr) for paragraph/character styles."
          },
          "tbl_format": {
            "type": "object",
            "description": "Табличные свойства стиля (w:tblPr/w:tblStylePr) — опционально, расширяется по мере необходимости.",
            "additionalProperties": true
          }
        }
      }
    },
    "content": {
      "type": "array",
      "description": "Содержимое документа (абзацы и таблицы)",
      "items": {
        "$ref": "#/$defs/contentItem"
      }
    }
  }
}